[TEMPLATE]
# ---------------------------------------------------------------------------
# Bandhan Events API — environment template
# Copy to apps/api/.env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Database — MongoDB Atlas or a self-managed instance.
# Leave empty in local development to run against a throwaway in-memory
# MongoDB (mongodb-memory-server). Production REQUIRES this value.
MONGODB_URI=
USE_IN_MEMORY_DB=true

# Sessions — required in production, minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
COOKIE_NAME=bandhan_sid
# Set when the dashboard and API share a parent domain, e.g. .bandhanevents.in
COOKIE_DOMAIN=
# Leave empty in development: derived from NODE_ENV (secure in production).
COOKIE_SECURE=
# "lax" when both run on the same site; "none" for cross-site production
# deployments (requires HTTPS).
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API with credentials (comma separated).
# Development falls back to loopback origins automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only when a reverse proxy you control sets X-Forwarded-For.
TRUST_PROXY=false

# Sign-in protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# Public enquiry protection
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=60

# Email — "console" logs messages instead of sending them. Nothing claims an
# email was delivered unless a real provider accepted it.
EMAIL_PROVIDER=console
EMAIL_FROM=Bandhan Events <no-reply@bandhanevents.in>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Seed credentials (used only by `npm run seed`). Passwords must satisfy the
# policy: 12+ characters with upper, lower, number and symbol.
# Emails are defaults supplied by the owners and can be overridden.
# ---------------------------------------------------------------------------
SEED_OWNER1_EMAIL=bhavesh@gmail.com
SEED_OWNER1_PASSWORD=
SEED_OWNER2_EMAIL=zakir@gmail.com
SEED_OWNER2_PASSWORD=
SEED_ADMIN_EMAIL=admin-adminzee@gmail.com
SEED_ADMIN_PASSWORD=
SEED_MANAGER_EMAIL=manager1@gmail.com
SEED_MANAGER_PASSWORD=

# Optional business values applied during seeding
BUSINESS_PHONE_DISPLAY=
BUSINESS_WHATSAPP_NUMBER=
BUSINESS_EMAIL=
BUSINESS_INSTAGRAM_URL=
BUSINESS_INSTAGRAM_HANDLE=

# ---------------------------------------------------------------------------
# Optional third-party integrations. The dashboard reports each of these as
# "not connected" until real credentials exist, and no operation pretends to
# have succeeded.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sheets integration
# Share the spreadsheet with the service account email (read/write access)
GOOGLE_SHEETS_SPREADSHEET_ID=1AQ7ModRBtO7BHqHynBHa9aycl_5uhr1A7W44PZIloX4
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
