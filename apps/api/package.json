{
  "name": "@bandhan/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bandhan Events API — auth, RBAC, CRM leads, settings, audit",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "dev:seeded": "node --env-file-if-exists=.env --import tsx scripts/dev.ts"
  },
  "dependencies": {
    "@bandhan/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "mongodb-memory-server": "^10.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
