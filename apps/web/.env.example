# Public site configuration.
# Copy this file to ".env" and fill in real values when available.
# NEVER put secrets, API keys or database credentials here — everything in
# VITE_* variables is embedded in the public JS bundle.

# WhatsApp business number in international format, digits only.
VITE_WHATSAPP_NUMBER=919820080526

# Public contact details — placeholders until confirmed.
VITE_CONTACT_PHONE_DISPLAY=Coming Soon
VITE_CONTACT_EMAIL=hello@bandhanevents.in

# Canonical site URL (no trailing slash) used for SEO + sitemap.
VITE_SITE_URL=https://bandhanevents.in

# Instagram profile URL — placeholder until confirmed.
VITE_INSTAGRAM_URL=https://www.instagram.com/
